# ═══════════════════════════════════════════════════════════════
# خيال — قالب متغيّرات البيئة
# انسخه إلى .env.local للتطوير، أو املأ القيم في Vercel → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Supabase (إلزامي) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session Pooler (Supabase → Connect → Session pooler)
# مثال: postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ── OpenRouter (إلزامي للتحسين) ──────────────────────────────
OPENROUTER_API_KEY=

# ── الأدمن ────────────────────────────────────────────────────
# أنشئ hash بـ: node scripts/hash-admin.mjs "كلمة-المرور"
ADMIN_PASSWORD_HASH=
# بديل: كلمة مرور نصية (أقل أماناً — للتجارب فقط)
ADMIN_PASSWORD=
# سرّ جلسة الأدمن — أنشئه بـ: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Cron والإشعارات ──────────────────────────────────────────
CRON_SECRET=
PUSH_WEBHOOK_SECRET=

# ── Firebase Cloud Messaging (اختياري — للإشعارات) ──────────
# محتوى ملف google-services.json الخاص بـ Firebase Admin (JSON في سطر واحد)
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Google OAuth (اختياري — لتسجيل الدخول عبر Google) ──────
# من Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: https://<PROJECT>.supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── الأمان والتحصين ──────────────────────────────────────────
# مِلح لتشفير عناوين IP في rate limiter — عشوائي لكل deployment
# أنشئه بـ: openssl rand -hex 16
IP_SALT=

# ── النطاق العام (للـ SEO والأمان) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://khiyal-web.vercel.app